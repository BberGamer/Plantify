{
  "name": "plantify-backend",
  "version": "1.0.0",
  "description": "Plantify REST API – Plant identification, disease diagnosis & care scheduling",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:auth": "node ../scripts/run-auth-tests.cjs",
    "test:google": "node ../scripts/run-auth-tests.cjs --test-directory=google-tests",
    "test:user": "node ../scripts/run-auth-tests.cjs --test-directory=user-tests",
    "test:finance": "node ../scripts/run-auth-tests.cjs --test-directory=finance-tests",
    "test:catalog": "node ../scripts/run-auth-tests.cjs --test-directory=catalog-tests",
    "test:garden": "node ../scripts/run-auth-tests.cjs --test-directory=garden-tests",
    "test:diagnosis": "node ../scripts/run-auth-tests.cjs --test-directory=diagnosis-tests",
    "test:chatai": "node ../scripts/run-auth-tests.cjs --test-directory=chatai-tests",
    "test:treatment-schedule": "node ../scripts/run-auth-tests.cjs --test-directory=treatment-schedule-tests",
    "test:feedback": "node ../scripts/run-auth-tests.cjs --test-directory=feedback-tests",
    "test:notification": "node ../scripts/run-auth-tests.cjs --test-directory=notification-tests",
    "test:care": "node ../scripts/run-auth-tests.cjs --test-directory=care-tests"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^14.5.1",
    "google-auth-library": "^11.3.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^7.5.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^6.9.13",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "docx": "^9.16.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.3.1"
  }
}
