# ===== SERVER =====
PORT=5000
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Public backend origin for garden photo URLs; use a reachable LAN IP on real devices.
PUBLIC_BASE_URL=http://localhost:5000

# Diagnosis photos: local for development, cloudinary for cloud storage.
# Cloudinary assets are authenticated; all credentials stay in backend only.
DIAGNOSIS_PHOTO_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Diagnosis photos: local preserves existing installations; set cloudinary after configuring keys.
DIAGNOSIS_PHOTO_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== DATABASE =====
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DB_NAME=plantify_db

# ===== JWT =====
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES=30d

# ===== EMAIL (Nodemailer - Gmail) =====
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# ===== EXTERNAL APIs =====
AI_API_KEY=
AI_BASE_URL=https://platform.beeknoee.com/api/v1
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_FAQ_ENABLED=true
# Auto CCC evaluation in the app: default enabled in development, disabled in production.
# Does one extra provider call per matched reference; scores are advisory.
AI_EVALUATION_ENABLED=true
# Optional different judge model; defaults to AI_MODEL.
AI_EVALUATOR_MODEL=
AI_EVALUATION_TIMEOUT_MS=60000

OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_API_KEY=your-openweathermap-api-key

OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ===== PAYMENT (SePay) =====
SEPAY_WEBHOOK_SECRET=your-sepay-hmac-secret
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Số VA chính thức dùng nhận chuyển khoản/QR (để trống nếu nhận qua tài khoản chính).
# ACCOUNT_NUMBER vẫn là tài khoản chính, phải khớp accountNumber webhook.
# VIRTUAL_ACCOUNT phải khớp subAccount webhook; không dùng mã TKP nội dung ở đây.
SEPAY_VIRTUAL_ACCOUNT=

# ===== FIREBASE (FCM Push Notification) =====
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ===== DIAGNOSIS (internal Python inference; mobile calls Express only) =====
# Base URL; /predict is appended by the adapter. Keep private, not a mobile URL.
DIAGNOSIS_INFERENCE_URL=http://127.0.0.1:8001
DIAGNOSIS_TIMEOUT_MS=20000
# Initial abstention rules, not calibrated probabilities or an OOD detector.
DIAGNOSIS_MIN_CONFIDENCE=0.70
DIAGNOSIS_MIN_MARGIN=0.15
DIAGNOSIS_UNRECOGNIZED_BELOW=0.35
# Plant recognition aggregates ALL class scores by DB plant_id. Initial, uncalibrated thresholds.
IDENTIFICATION_MIN_CONFIDENCE=0.70
IDENTIFICATION_MIN_MARGIN=0.15
IDENTIFICATION_UNRECOGNIZED_BELOW=0.35

# Local MobileCLIP2 guard. Initial cosine thresholds need evaluation on Plantify images.
# Missing model/service fails closed when required. Scores are not probabilities.
DIAGNOSIS_REQUIRE_INPUT_GUARD=true
DIAGNOSIS_GUARD_MIN_SIMILARITY=0.23
DIAGNOSIS_GUARD_MIN_MARGIN=0.025
