{
  "expo": {
    "name": "Plantify",
    "slug": "plantify",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "plantify",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.plantify.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
