{
  "expo": {
    "name": "Plantify",
    "slug": "plantify",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "plantify",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.plantify.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.238677633473-5irbpqgjre603gjamhjqgvi5d7dth7v3"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Plantify sử dụng camera để chụp ảnh cây.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Plantify chọn ảnh cây từ thư viện.",
          "cameraPermission": "Cho phép Plantify sử dụng camera để chụp ảnh cây.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2ac2679e-cdc9-404d-8a9f-09fe8830381e"
      }
    }
  }
}
